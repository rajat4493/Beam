# Local mode needs no external credentials.
NODE_ENV=development
PAYMENT_PROVIDER=mock
APP_ORIGIN=http://localhost:3000
# Required for internal pilot write/dashboard APIs in any shared environment.
# Generate a long random value and keep it server-side only.
PILOT_ADMIN_TOKEN=
OUTBOX_WORKER_TOKEN=
# Optional test/pilot return target after Stripe Checkout.
YOUTUBE_RETURN_URL=https://www.youtube.com/
# PILOT_CURRENCY=INR
# Required only when a real provider adapter is enabled; never put these in a browser bundle.
# PAYMENT_WEBHOOK_SECRET=
